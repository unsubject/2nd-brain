DATABASE_URL=postgresql://journal:journal@localhost:5432/journal
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Numeric Telegram user id(s) allowed to use the bot, comma-separated (ask
# @userinfobot). Messages from anyone else are ignored; unset = nobody.
OWNER_TELEGRAM_USER_IDS=123456789
OPENAI_API_KEY=your-openai-api-key
# The Telegram webhook's secret token is derived from this (it is sent in a
# header, never in the URL). Every boot registers the webhook with it.
WEBHOOK_SECRET=some-random-secret-string
WEBHOOK_URL=https://your-app.railway.app
ARCHIVE_API_KEY=a-random-secret-for-the-archive-endpoints
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app.railway.app/auth/google/callback
# Owner secret (same value as the MCP Worker's OWNER_SECRET). Required to
# connect a Google account at /auth/google; without it that route is disabled.
OWNER_SECRET=a-long-random-secret
PORT=3000
# Days of MCP Worker call log to keep (default 90, minimum 7)
# MCP_CALL_LOG_RETENTION_DAYS=90
