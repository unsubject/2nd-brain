{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static Terms of Service and Privacy Statement for every unsubject.com
  // project, published by Unsubject LLC. Assets-only Worker: no script,
  // just the files in ./public.
  "name": "unsubject-legal",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    // /terms serves terms.html, and /terms.html redirects to /terms.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  // Custom Domain: the Worker is the origin for the whole hostname, and
  // Cloudflare creates the DNS record and certificate on deploy. The
  // hostname must not already have a CNAME record, and the deploy token
  // needs Zone → Workers Routes → Edit on unsubject.com.
  "routes": [
    { "pattern": "legal.unsubject.com", "custom_domain": true }
  ]
}
